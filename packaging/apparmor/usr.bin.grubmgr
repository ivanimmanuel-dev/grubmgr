# SPDX-License-Identifier: MIT
# Ubuntu 24.04 requires an application profile for unprivileged namespaces.
# Bubblewrap still supplies the preview's mount, PID and network isolation.
# This unconfined profile grants userns permission to the application.
abi <abi/4.0>,
include <tunables/global>

profile grubmgr /usr/bin/grubmgr flags=(unconfined) {
  userns,
  include if exists <local/usr.bin.grubmgr>
}
